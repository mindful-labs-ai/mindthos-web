# SUPABASE Configuration
VITE_WEBAPP_SUPABASE_URL=your-supabase-url
VITE_WEBAPP_SUPABASE_ANON_KEY=your-supabase-anon-key

# mindthos-server REST /v1 API
# Docker 배포는 브라우저가 같은 origin의 nginx proxy를 사용하도록 반드시 /로 둔다.
# 로컬 개발에서 비우면 Vite dev proxy가 게이트웨이로 forward한다.
VITE_SERVER_API_URL=/

# 로컬 통합 크레딧 QA 페이지(/dev/credit-qa). 운영 환경에서는 반드시 false.
VITE_ENABLE_CREDIT_QA=false

# 알림: 백엔드 없이 인메모리 mock으로 확인하려면 true. 기본(미설정)은 실제 서버 API 사용.
VITE_USE_MOCK_NOTIFICATIONS=false

# 캘린더: 백엔드 없이 mock으로 확인하려면 true. 기본(미설정)은 실제 서버 API 사용.
VITE_USE_MOCK_CALENDAR=false

# 문서: 백엔드 없이 mock으로 확인하려면 true. 기본(미설정)은 실제 서버 API 사용.
VITE_USE_MOCK_DOCUMENTS=false

# TOSS Configuration
VITE_TOSS_PAYMENTS_CLIENT_KEY=your-toss-payments-client-key

# Mixpanel Configuration
VITE_MIXPANEL_TOKEN=your-mixpanel-token

# Gemini AI Configuration (Server-side only)
GEMINI_API_KEY=your-gemini-api-key
